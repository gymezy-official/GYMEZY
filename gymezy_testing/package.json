{
  "name": "gymezy-automation-testing",
  "version": "1.0.0",
  "description": "GYMEZY Playwright UI and API Test Automation Suite",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:p1": "playwright test --grep @P1",
    "test:p2": "playwright test --grep @P2",
    "test:p3": "playwright test --grep @P3",
    "test:smoke": "playwright test --grep @Smoke",
    "test:regression": "playwright test --grep @Regression",
    "test:owner": "playwright test --project=owner-portal",
    "test:admin": "playwright test --project=super-admin",
    "test:member": "playwright test --project=member-portal",
    "test:owner:web": "playwright test tests/owner/website",
    "test:admin:web": "playwright test tests/super-admin/website",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report reports/playwright-html"
  },
  "keywords": [
    "playwright",
    "qa",
    "automation",
    "testing",
    "gymezy"
  ],
  "author": "QA Team",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "dotenv": "^16.4.7"
  }
}

